datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  profile      Profile?
  sessions     Session[]
  workspaces   Workspace[]

  @@map("users")
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Session {
  id                 String   @id @default(cuid())
  userId             String
  hashedRefreshToken String
  userAgent          String?
  ipAddress          String?
  expiresAt          DateTime
  isRevoked          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Workspace {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  icon        String   @default("Briefcase")
  color       String   @default("blue")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  areas       Area[]

  @@index([userId])
  @@map("workspaces")
}

model Area {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  description String?
  icon        String    @default("Layers")
  color       String    @default("indigo")
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects    Project[]

  @@index([workspaceId])
  @@index([workspaceId, order])
  @@unique([workspaceId, name])
  @@map("areas")
}

enum NodeType {
  CONCEPT
  COMPONENT
  SERVICE
  MODULE
  DATABASE
  INTERFACE
  CUSTOM

  @@map("node_types")
}

enum RelationType {
  RELATES_TO
  DEPENDS_ON
  CONTAINS

  @@map("relation_types")
}

model Project {
  id            String             @id @default(cuid())
  areaId        String
  name          String
  description   String?
  icon          String             @default("Folder")
  color         String             @default("cyan")
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  area          Area               @relation(fields: [areaId], references: [id], onDelete: Cascade)
  nodes         Node[]
  relationships NodeRelationship[]

  @@index([areaId])
  @@index([areaId, updatedAt])
  @@unique([areaId, name])
  @@map("projects")
}

model Node {
  id                    String             @id @default(cuid())
  projectId             String
  name                  String
  description           String?
  nodeType              NodeType           @default(CONCEPT)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  project               Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  outgoingRelationships NodeRelationship[] @relation("SourceNode")
  incomingRelationships NodeRelationship[] @relation("TargetNode")

  @@index([projectId])
  @@index([projectId, createdAt])
  @@unique([projectId, name])
  @@map("nodes")
}

model NodeRelationship {
  id           String       @id @default(cuid())
  projectId    String
  sourceNodeId String
  targetNodeId String
  type         RelationType @default(RELATES_TO)
  label        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceNode   Node         @relation("SourceNode", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode   Node         @relation("TargetNode", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([sourceNodeId])
  @@index([targetNodeId])
  @@unique([projectId, sourceNodeId, targetNodeId, type])
  @@map("node_relationships")
}
